# Copy this file to .env next to DesktopPet.exe and fill in your own values.
# Base URL includes the API prefix (usually /v1), not the website home page.
# OpenAI example: https://api.openai.com/v1
# Local example: http://127.0.0.1:1234/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# Model must be an exact model ID offered by your provider.
# Blank API key is permitted only for a loopback (localhost/127.0.0.1) endpoint.
# Values may be quoted. No variable interpolation. AI_* environment values override this file.
